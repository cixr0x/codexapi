HOST=127.0.0.1
PORT=3001
# Dedicated, existing, empty directory used as the only inference workspace.
CODEX_WORKSPACE=C:\CodexAPI\inference-workspace
# Dedicated Codex home. Authenticate this identity separately from development accounts.
CODEX_HOME=C:\CodexAPI\home
CODEX_TIMEOUT_MS=120000
# Every API request must supply its own nonblank model ID; no server model default or catalog.
# Optional verification-client override; its own default is gpt-5.6-terra.
# Both probes send an explicit model. An explicitly blank setting is rejected.
# CODEX_ISOLATION_MODEL=gpt-5.6-terra
# Default reasoning effort: low, medium, high, xhigh, max, or ultra.
CODEX_REASONING_EFFORT=medium
CODEX_CALL_LOGGING=false
CODEX_CALL_LOG_DIR=.codexapi\logs
